{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/items/account-access/lib/auth": ["./packages/modules/account-access/src/items/account-access/lib/auth.ts"],
      "@/items/query-client/lib/query-client": [
        "./packages/modules/query-client/src/items/query-client/lib/query-client.ts"
      ],
      "@/items/sse-stream/lib/sse-stream": ["./packages/modules/sse-stream/src/items/sse-stream/lib/sse-stream.ts"],
      // TypeScript allows one `*` per path entry, so cross-item module imports
      // are listed explicitly (R84-06).
      "@/items/password-checklist/components/password-checklist": [
        "./packages/modules/password-checklist/src/items/password-checklist/components/password-checklist"
      ],
      "@/items/notification-center/components/notification-presentation": [
        "./packages/modules/notification-center/src/items/notification-center/components/notification-presentation"
      ],
      "@testing/*": ["./harness/testing/*"],
      "@/*": ["./harness/framework/*"]
    }
  },
  "include": [
    "harness",
    "vitest.config.ts",
    "test",
    "packages/modules/*/src/**/*.ts",
    "packages/modules/*/src/**/*.tsx",
    "packages/modules/*/test/**/*.ts",
    "packages/modules/*/test/**/*.tsx"
  ]
}
