{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/lib/auth": ["./packages/modules/auth/src/lib/auth.ts"],
      "@/lib/query-client": ["./packages/modules/query-client/src/lib/query-client.ts"],
      "next/navigation": ["./harness/next-navigation.ts"],
      "next/link": ["./harness/next-link.tsx"],
      "@/*": ["./harness/*"]
    }
  },
  "include": [
    "harness",
    "vitest.config.ts",
    "test",
    "packages/modules/*/src/**/*.ts",
    "packages/modules/*/src/**/*.tsx",
    "packages/modules/*/test/**/*.tsx"
  ]
}
